<footer>
  <a href="{{ '/' | url }}" class="f-logo">ГРУЗ<span>Ъ</span></a>
  <span class="f-copy">© 2024–2026 ГРУЗЪ — Переезды и перевозки по городу и области</span>
</footer>

<div class="mobile-sticky-bar">
  <a href="tel:{{ site.phoneHref }}" class="mobile-sticky-call">Позвонить</a>
  <button type="button" class="mobile-sticky-msg" id="openMsgPicker">Написать</button>
  <button type="button" class="mobile-sticky-form" id="openQuickForm">Заявка</button>
</div>

<div class="msg-picker-overlay" id="msgPickerOverlay">
  <div class="msg-picker-sheet">
    <div class="msg-picker-title">Написать нам</div>
    <a href="{{ site.social.telegram }}" class="msg-picker-btn" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4z"/><path d="m22 2-11 11"/></svg>
      Telegram
    </a>
    <a href="{{ site.social.max }}" class="msg-picker-btn" target="_blank" rel="noopener">
      <svg viewBox="0 0 720 720" fill="currentColor" style="width:20px;height:20px" aria-hidden="true"><path d="M350.4,9.6C141.8,20.5,4.1,184.1,12.8,390.4c3.8,90.3,40.1,168,48.7,253.7,2.2,22.2-4.2,49.6,21.4,59.3,31.5,11.9,79.8-8.1,106.2-26.4,9-6.1,17.6-13.2,24.2-22,27.3,18.1,53.2,35.6,85.7,43.4,143.1,34.3,299.9-44.2,369.6-170.3C799.6,291.2,622.5-4.6,350.4,9.6h0ZM269.4,504c-11.3,8.8-22.2,20.8-34.7,27.7-18.1,9.7-23.7-.4-30.5-16.4-21.4-50.9-24-137.6-11.5-190.9,16.8-72.5,72.9-136.3,150-143.1,78-6.9,150.4,32.7,183.1,104.2,72.4,159.1-112.9,316.2-256.4,218.6h0Z"/></svg>
      MAX
    </a>
    <button type="button" class="msg-picker-cancel" id="closeMsgPicker">Отмена</button>
  </div>
</div>

<div class="quick-form-overlay" id="quickFormOverlay">
  <div class="quick-form-modal">
    <button type="button" class="quick-form-close" id="closeQuickForm" aria-label="Закрыть">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <div class="quick-form-title">Оставьте заявку — перезвоним за 5 минут</div>
    <form id="quickForm">
      <div style="position:absolute;left:-9999px;opacity:0;height:0;overflow:hidden" aria-hidden="true">
        <input type="text" name="website" tabindex="-1" autocomplete="off">
      </div>
      <input type="hidden" name="_qftoken" id="qfToken">
      <input type="text" name="name" placeholder="Ваше имя" required class="quick-form-input" id="qfName">
      <div class="quick-form-error" id="qfNameErr"></div>
      <input type="tel" name="phone" placeholder="+7 (___) ___-__-__" required class="quick-form-input" id="qfPhone">
      <div class="quick-form-error" id="qfPhoneErr"></div>
      <button type="submit" class="quick-form-submit" id="qfSubmit" disabled>Отправить заявку</button>
    </form>
    <div class="quick-form-msg" id="quickFormMsg"></div>
  </div>
</div>
