{%- set serviceHeroVariant = serviceHeroVariant or 'default' -%}
{%- if serviceHeroVariant == 'golden' -%}
  {%- set heroData = service.landing.hero -%}
  {%- set heroImage = heroData.image or {} -%}
  {%- set heroImageSrc = heroImage.src or '' -%}
  {%- set heroImageAlt = heroImage.alt or service.h1 -%}
  {%- set fallbackVisual = heroData.fallbackVisual or {} -%}
  {%- set fallbackPills = fallbackVisual.pills or [] -%}
<section class="service-hero service-hero--golden">
  <div class="service-hero-left">
    <div class="service-hero-text">
      <div class="service-hero-breadcrumbs reveal">
        <a href="{{ '/' | url }}">Главная</a>
        <span>/</span>
        <span>{{ service.h1 }}</span>
      </div>
      <div class="service-hero-label-pill reveal rd1">{{ heroData.label }}</div>
      <h1 class="service-hero-title">
        <span class="service-hero-title-line">{{ heroData.title or service.h1 }}</span>
      </h1>
      <p class="service-hero-subtitle">{{ heroData.subtitle }}</p>
      {%- if heroData.priceFrom -%}
      <div class="service-hero-price-pill">{{ heroData.priceFrom }}</div>
      {%- endif -%}
      <div class="service-hero-cta-row">
        <a href="#contact" class="btn-main"><span>{{ heroData.primaryCtaLabel }}</span></a>
        <a href="{{ heroData.secondaryCtaHref or ('/' | url) }}" class="btn-outline">{{ heroData.secondaryCtaLabel }}</a>
      </div>
      <div class="hero-msg-row">
        <a href="{{ site.social.telegram }}" class="hero-tg-link" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4z"/><path d="m22 2-11 11"/></svg>
          <span>Telegram</span>
        </a>
        <a href="{{ site.social.max }}" class="hero-tg-link" target="_blank" rel="noopener">
          <svg viewBox="0 0 720 720" fill="currentColor" aria-hidden="true"><path d="M350.4,9.6C141.8,20.5,4.1,184.1,12.8,390.4c3.8,90.3,40.1,168,48.7,253.7,2.2,22.2-4.2,49.6,21.4,59.3,31.5,11.9,79.8-8.1,106.2-26.4,9-6.1,17.6-13.2,24.2-22,27.3,18.1,53.2,35.6,85.7,43.4,143.1,34.3,299.9-44.2,369.6-170.3C799.6,291.2,622.5-4.6,350.4,9.6h0ZM269.4,504c-11.3,8.8-22.2,20.8-34.7,27.7-18.1,9.7-23.7-.4-30.5-16.4-21.4-50.9-24-137.6-11.5-190.9,16.8-72.5,72.9-136.3,150-143.1,78-6.9,150.4,32.7,183.1,104.2,72.4,159.1-112.9,316.2-256.4,218.6h0Z"/></svg>
          <span>MAX</span>
        </a>
      </div>
      <ul class="service-hero-trust-list">
        {%- for item in heroData.trustBullets -%}
        <li class="service-hero-trust-item reveal rd{{ (loop.index0 % 4) + 1 }}">
          <span class="service-hero-trust-dot"></span>
          <span>{{ item }}</span>
        </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
  <div class="service-hero-right">
    <div class="service-hero-visual{% if not heroImageSrc %} service-hero-visual--fallback{% endif %}">
      {%- if heroImageSrc -%}
      <img class="service-hero-visual-image" src="{{ heroImageSrc | url }}" alt="{{ heroImageAlt }}" width="1536" height="1024" fetchpriority="high" decoding="async">
      {%- else -%}
      <div class="service-hero-visual-fallback" role="img" aria-label="{{ heroImageAlt }}">
        <div class="service-hero-visual-fallback-inner">
          <span class="service-hero-visual-fallback-kicker">{{ fallbackVisual.kicker or heroData.label }}</span>
          <h2 class="service-hero-visual-fallback-title">{{ fallbackVisual.title or heroData.visualTitle }}</h2>
          {%- if fallbackPills.length -%}
          <ul class="service-hero-visual-fallback-pills">
            {%- for pill in fallbackPills -%}
            <li>{{ pill }}</li>
            {%- endfor -%}
          </ul>
          {%- endif -%}
        </div>
      </div>
      {%- endif -%}
      <div class="service-hero-visual-card">
        <span class="service-hero-visual-badge">{{ heroData.visualBadge }}</span>
        <h2 class="service-hero-visual-title">{{ heroData.visualTitle }}</h2>
        <ul class="service-hero-visual-list">
          {%- for point in heroData.visualPoints -%}
          <li>{{ point }}</li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>
{%- else -%}
<section class="service-hero service-hero--default">
  <div class="service-hero-left">
    <div>
      <div class="service-hero-breadcrumbs reveal">
        <a href="{{ '/' | url }}">Главная</a>
        <span>/</span>
        <span>{{ service.h1 }}</span>
      </div>
      <div class="service-hero-eyebrow">
        <div class="service-hero-eyebrow-dot"></div>
        <span class="service-hero-eyebrow-text">{{ service.hero.eyebrow }}</span>
      </div>
      <h1 class="service-hero-title">
        <span class="service-hero-title-line">{{ service.h1 }}</span>
      </h1>
      <p class="service-hero-offer">{{ service.hero.offer }}</p>
      <p class="service-hero-desc">{{ service.hero.text }}</p>
      <div class="service-hero-cta-row">
        <a href="#contact" class="btn-main"><span>{{ service.hero.primaryCtaLabel }}</span></a>
        <a href="{{ '/' | url }}" class="btn-outline">{{ service.hero.secondaryCtaLabel }}</a>
      </div>
      <div class="hero-msg-row">
        <a href="{{ site.social.telegram }}" class="hero-tg-link" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4z"/><path d="m22 2-11 11"/></svg>
          <span>Telegram</span>
        </a>
        <a href="{{ site.social.max }}" class="hero-tg-link" target="_blank" rel="noopener">
          <svg viewBox="0 0 720 720" fill="currentColor" aria-hidden="true"><path d="M350.4,9.6C141.8,20.5,4.1,184.1,12.8,390.4c3.8,90.3,40.1,168,48.7,253.7,2.2,22.2-4.2,49.6,21.4,59.3,31.5,11.9,79.8-8.1,106.2-26.4,9-6.1,17.6-13.2,24.2-22,27.3,18.1,53.2,35.6,85.7,43.4,143.1,34.3,299.9-44.2,369.6-170.3C799.6,291.2,622.5-4.6,350.4,9.6h0ZM269.4,504c-11.3,8.8-22.2,20.8-34.7,27.7-18.1,9.7-23.7-.4-30.5-16.4-21.4-50.9-24-137.6-11.5-190.9,16.8-72.5,72.9-136.3,150-143.1,78-6.9,150.4,32.7,183.1,104.2,72.4,159.1-112.9,316.2-256.4,218.6h0Z"/></svg>
          <span>MAX</span>
        </a>
      </div>
    </div>
    <div class="service-hero-stats-row">
      {%- for stat in service.hero.stats -%}
      <div class="service-hero-stat">
        <div class="service-hero-stat-big">{{ stat.value }}</div>
        <div class="service-hero-stat-sm">{{ stat.label }}</div>
      </div>
      {%- endfor -%}
    </div>
  </div>
  <div class="service-hero-right">
    <div class="service-hero-media">
      <img class="service-hero-media-image" src="{{ '/assets/img/hero.webp' | url }}" alt="{{ service.h1 }}" width="1024" height="1024" fetchpriority="high" decoding="async">
    </div>
    <div class="service-hero-facts">
      {%- for fact in service.hero.facts -%}
      <div class="service-hero-fact">
        <div class="service-hero-fact-label">{{ fact.label }}</div>
        <div class="service-hero-fact-value">{{ fact.value }}</div>
      </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
